{
  "OpenApi": {
    "Enabled": false
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "supervisor-dashboard-route": {
        "ClusterId": "project",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/supervisor/dashboard"
        }
      },
      "project-github-route": {
        "ClusterId": "github",
        "Order": -10,
        "Match": {
          "Path": "/api/v1/projects/{projectId}/github/{**catch-all}"
        }
      },
      "project-jira-route": {
        "ClusterId": "jira",
        "Order": -10,
        "Match": {
          "Path": "/api/v1/projects/{projectId}/jira/{**catch-all}"
        }
      },
      "project-meetings-route": {
        "ClusterId": "meeting",
        "Order": -10,
        "Match": {
          "Path": "/api/v1/projects/{projectId}/meetings/{**catch-all}"
        }
      },
      "project-submissions-route": {
        "ClusterId": "submission",
        "Order": -10,
        "Match": {
          "Path": "/api/v1/projects/{projectId}/submissions/{**catch-all}"
        }
      },
      "projects-route": {
        "ClusterId": "project",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/projects/{**catch-all}"
        }
      },
      "github-route": {
        "ClusterId": "github",
        "Match": {
          "Path": "/api/v1/github/{**catch-all}"
        }
      },
      "jira-route": {
        "ClusterId": "jira",
        "Match": {
          "Path": "/api/v1/jira/{**catch-all}"
        }
      },
      "meetings-route": {
        "ClusterId": "meeting",
        "Match": {
          "Path": "/api/v1/meetings/{**catch-all}"
        }
      },
      "submissions-route": {
        "ClusterId": "submission",
        "Match": {
          "Path": "/api/v1/submissions/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "project": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "github": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "jira": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "meeting": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "submission": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
