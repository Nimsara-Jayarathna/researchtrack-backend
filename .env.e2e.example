# ResearchTrack Selenium E2E configuration.
# Copy this file to .env.e2e and provide real TEST-environment values.
# Never commit .env.e2e because it contains test credentials.

E2E_BASE_URL=https://test.researchtrack.blipzo.xyz

E2E_SUPERVISOR_EMAIL=
E2E_SUPERVISOR_PASSWORD=

E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=

# The same connected ResearchTrack project must be accessible by both accounts.
E2E_PROJECT_ID=

# E2E-002: before running, change this Jira issue to the expected status.
E2E_EXPECTED_JIRA_ISSUE_KEY=
E2E_EXPECTED_JIRA_STATUS=

E2E_BROWSER=chrome
E2E_HEADLESS=true
E2E_ACCEPT_INSECURE_CERTIFICATES=false
E2E_TIMEOUT_SECONDS=30
