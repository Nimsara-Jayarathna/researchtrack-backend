    {
      "id": 14,
      "title": "Pending Kafka Outbox Messages",
      "type": "timeseries",
      "description": "Cached 60-second database samples; failed/stale samples show no data, not healthy zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "researchtrack_kafka_outbox_messages{job=\"researchtrack-services\", environment=~\"$environment\",status=\"pending\"} and on(service,environment) researchtrack_kafka_outbox_sample_success{job=\"researchtrack-services\", environment=~\"$environment\"} == 1 and on(service,environment) (time()-researchtrack_kafka_outbox_sample_timestamp_seconds{job=\"researchtrack-services\", environment=~\"$environment\"}) < 180 and on(service,environment) researchtrack_kafka_enabled{job=\"researchtrack-services\", environment=~\"$environment\"} == 1",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
