# These are Compose/deployment controls, not application secrets.
# GitHub Actions supplies them at deployment time.
IMAGE_PREFIX=ghcr.io/example
IMAGE_TAG=test
EDGE_NETWORK=npm_default
GATEWAY_ALIAS=researchtrack-gateway-test

GATEWAY_MEMORY_LIMIT=384m
AUTH_MEMORY_LIMIT=384m
PROJECT_MEMORY_LIMIT=384m
GITHUB_MEMORY_LIMIT=320m
JIRA_MEMORY_LIMIT=320m
MEETING_MEMORY_LIMIT=320m
SUBMISSION_MEMORY_LIMIT=320m
MYSQL_MEMORY_LIMIT=896m
