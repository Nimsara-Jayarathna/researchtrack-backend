# Rendered by scripts/reconcile-stack.sh into runtime/kafka/server.properties
# (root:1000 0640, contains the keystore password). Single KRaft broker/controller,
# replication factor 1: assignment-scale, not highly available.

process.roles=broker,controller
node.id=1
controller.quorum.voters=1@localhost:9093
controller.listener.names=CONTROLLER

# EXTERNAL: TLS, the only listener published (to the VM private IP) for Container Apps.
# INTERNAL: plaintext, Docker network only (inter-broker and on-VM tools).
listeners=EXTERNAL://0.0.0.0:9092,INTERNAL://0.0.0.0:29092,CONTROLLER://localhost:9093
advertised.listeners=EXTERNAL://__INFRA_PRIVATE_IP__:9092,INTERNAL://kafka:29092
listener.security.protocol.map=EXTERNAL:SSL,INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
inter.broker.listener.name=INTERNAL

ssl.keystore.type=PKCS12
ssl.keystore.location=/etc/researchtrack/kafka-tls/broker.p12
ssl.keystore.password=__KAFKA_KEYSTORE_PASSWORD__
ssl.key.password=__KAFKA_KEYSTORE_PASSWORD__
ssl.enabled.protocols=TLSv1.3,TLSv1.2
# Server authentication/encryption only for now; client authentication (mTLS or
# SASL) arrives with the Kafka application integration phase.
ssl.client.auth=none

log.dirs=/var/lib/kafka/data
num.partitions=3
default.replication.factor=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
log.retention.hours=__KAFKA_RETENTION_HOURS__
log.retention.bytes=1073741824
log.segment.bytes=268435456
