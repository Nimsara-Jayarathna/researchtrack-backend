# Nginx -> private Gateway Container App (internal environment, over the VNet).
# Nginx never routes to the other six services; the Gateway does.
set $researchtrack_gateway https://__GATEWAY_FQDN__;
proxy_pass $researchtrack_gateway;
proxy_http_version 1.1;

proxy_ssl_server_name on;
proxy_ssl_name __GATEWAY_FQDN__;
proxy_ssl_verify __ACA_TLS_VERIFY__;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

# Container Apps ingress routes by Host, so it must be the app FQDN; the public
# hostname travels in X-Forwarded-Host. The Gateway trusts X-Forwarded-For only
# from private proxy hops (TrustedProxyForwarding.cs).
proxy_set_header Host __GATEWAY_FQDN__;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Real-IP $remote_addr;

proxy_connect_timeout 10s;
proxy_send_timeout 120s;
proxy_read_timeout 120s;
