# ResearchTrack Jira Service configuration contract.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5104
OpenApi__Enabled=true

ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3307;Database=CHANGE_ME;User=CHANGE_ME;Password=CHANGE_ME;SslMode=Disabled;AllowPublicKeyRetrieval=true

Database__Host=127.0.0.1
Database__Port=3307
Database__Name=CHANGE_ME
Database__TestName=CHANGE_ME
Database__Username=CHANGE_ME
Database__Password=CHANGE_ME
Database__SslMode=CHANGE_ME
Database__AllowPublicKeyRetrieval=CHANGE_ME

# Jira OAuth / Atlassian API
Jira__ClientId=CHANGE_ME
Jira__ClientSecret=CHANGE_ME
Jira__RedirectUri=CHANGE_ME
Jira__Scope=read:jira-user read:jira-work read:project:jira read:sprint:jira-software read:board-scope:jira-software read:issue-details:jira manage:jira-webhook offline_access
Jira__Audience=api.atlassian.com
Jira__AuthorizationUrl=https://auth.atlassian.com/authorize
Jira__TokenUrl=https://auth.atlassian.com/oauth/token
Jira__AccessibleResourcesUrl=https://api.atlassian.com/oauth/token/accessible-resources
Jira__ApiBaseUrl=https://api.atlassian.com

# Jira OAuth token encryption
# Must be a Base64-encoded 32-byte (256-bit) key.
# Generate once per environment and keep the same value across deployments.
# Test and Production MUST use different keys.
# Never commit the real value to source control.
Jira__TokenEncryptionKey=CHANGE_ME

# Jira OAuth lifecycle
Jira__OAuthStateTtlMinutes=15
Jira__SelectionTtlMinutes=15

# Downstream/API timeouts
Jira__AtlassianTimeoutSeconds=15
Jira__ProjectServiceTimeoutSeconds=10

# Jira webhook + reconciliation synchronization
Jira__WebhookUrl=CHANGE_ME
Jira__ReconciliationIntervalMinutes=15
Jira__WebhookCoalesceSeconds=3
Jira__SyncWorkerPollSeconds=2

# Internal services
Services__Project__BaseUrl=http://localhost:5102/

# Approved webhook-reference messaging; leave disabled until environment verification.
Kafka__Enabled=false
# Azure production default; use the actual broker endpoint for other environments.
Kafka__BootstrapServers=10.20.10.4:9092
Kafka__SecurityProtocol=SSL
Kafka__SslCaLocation=/tmp/researchtrack-kafka/ca.crt
# Base64 of the existing broker's public CA PEM; do not generate a replacement CA.
Kafka__SslCaCertificateBase64=
Kafka__EnableSslCertificateVerification=true
Kafka__SslEndpointIdentificationAlgorithm=https
Kafka__Topic=researchtrack.jira.events.v1
Kafka__ContractVersion=1
Kafka__ConsumerGroupId=researchtrack-jira-webhook-v1
