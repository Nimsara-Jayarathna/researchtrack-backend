# ResearchTrack Meeting Service - LOCAL DEVELOPMENT

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5105

OpenApi__Enabled=true

# -----------------------------
# Meeting database
# -----------------------------
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3307;Database=researchtrack_meeting;User=rt_meeting;Password=YOUR_MEETING_DB_PASSWORD;SslMode=Disabled;AllowPublicKeyRetrieval=true

Database__Host=127.0.0.1
Database__Port=3307
Database__Name=researchtrack_meeting
Database__TestName=researchtrack_test_meeting
Database__Username=rt_meeting
Database__Password=YOUR_MEETING_DB_PASSWORD
Database__SslMode=Disabled
Database__AllowPublicKeyRetrieval=true

# -----------------------------
# Internal ResearchTrack services
# -----------------------------

# Used for:
# - project access checks
# - Supervisor/manage permission checks
Services__Project__BaseUrl=http://localhost:5102

# Used for:
# - resolving authenticated user's display name
# - storing AddedByName / ApprovedByName snapshots
Services__Auth__BaseUrl=http://localhost:5101

# Timeout for the internal Project/Auth HTTP clients
Meeting__DependencyTimeoutSeconds=10