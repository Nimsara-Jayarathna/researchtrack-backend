# Deployment MySQL contract.
# This is not copied by scripts/setup.sh for normal local application startup.
# Store a completed version as MYSQL_ENV_FILE in each GitHub Environment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

AUTH_DB_NAME=researchtrack_auth
AUTH_DB_USER=rt_auth
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD

PROJECT_DB_NAME=researchtrack_project
PROJECT_DB_USER=rt_project
PROJECT_DB_PASSWORD=CHANGE_ME_PROJECT_DB_PASSWORD

GITHUB_DB_NAME=researchtrack_github
GITHUB_DB_USER=rt_github
GITHUB_DB_PASSWORD=CHANGE_ME_GITHUB_DB_PASSWORD

JIRA_DB_NAME=researchtrack_jira
JIRA_DB_USER=rt_jira
JIRA_DB_PASSWORD=CHANGE_ME_JIRA_DB_PASSWORD

MEETING_DB_NAME=researchtrack_meeting
MEETING_DB_USER=rt_meeting
MEETING_DB_PASSWORD=CHANGE_ME_MEETING_DB_PASSWORD

SUBMISSION_DB_NAME=researchtrack_submission
SUBMISSION_DB_USER=rt_submission
SUBMISSION_DB_PASSWORD=CHANGE_ME_SUBMISSION_DB_PASSWORD
