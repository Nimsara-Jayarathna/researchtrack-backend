# ResearchTrack Auth Service local configuration contract.
# Copy to .env.local in this directory and replace every CHANGE_ME value.
# Never commit .env.local.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5101
OpenApi__Enabled=true

Database__Host=127.0.0.1
Database__Port=3307
Database__Name=CHANGE_ME
Database__TestName=CHANGE_ME
Database__Username=CHANGE_ME
Database__Password=CHANGE_ME
Database__SslMode=CHANGE_ME
Database__AllowPublicKeyRetrieval=CHANGE_ME

# Story 1: registration policy. Values are intentionally external to source code.
Registration__StudentEmailDomain=CHANGE_ME
Registration__SupervisorEmailDomain=CHANGE_ME
Registration__StudentIdentifierPattern=CHANGE_ME
Registration__RequireStudentRegistrationNumber=CHANGE_ME
Registration__RequireStudentRegistrationNumberToMatchEmail=CHANGE_ME
Registration__MaxFirstNameLength=CHANGE_ME
Registration__MaxLastNameLength=CHANGE_ME
Registration__MaxEmailLength=CHANGE_ME
Registration__MaxRegistrationNumberLength=CHANGE_ME

PasswordPolicy__MinimumLength=CHANGE_ME
PasswordPolicy__MaximumLength=CHANGE_ME
PasswordPolicy__RequireUppercase=CHANGE_ME
PasswordPolicy__RequireLowercase=CHANGE_ME
PasswordPolicy__RequireDigit=CHANGE_ME
PasswordPolicy__RequireSpecialCharacter=CHANGE_ME

PasswordHashing__Iterations=CHANGE_ME
PasswordHashing__SaltSizeBytes=CHANGE_ME
PasswordHashing__HashSizeBytes=CHANGE_ME

# Reserved for Sprint 1 Story 2 authentication implementation.
Jwt__Issuer=CHANGE_ME
Jwt__Audience=CHANGE_ME
Jwt__SigningKey=CHANGE_ME
Jwt__AccessTokenMinutes=CHANGE_ME
Jwt__RefreshTokenDays=CHANGE_ME
