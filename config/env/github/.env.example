# ResearchTrack GitHub Service configuration contract.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5103
OpenApi__Enabled=true
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3307;Database=CHANGE_ME;User=CHANGE_ME;Password=CHANGE_ME;SslMode=Disabled;AllowPublicKeyRetrieval=true
Database__Host=127.0.0.1
Database__Port=3307
Database__Name=CHANGE_ME
Database__TestName=CHANGE_ME
Database__Username=CHANGE_ME
Database__Password=CHANGE_ME
Database__SslMode=CHANGE_ME
Database__AllowPublicKeyRetrieval=CHANGE_ME
GitHub__AppId=CHANGE_ME
GitHub__AppSlug=CHANGE_ME
GitHub__SetupCallbackUrl=http://localhost:5103/api/github/access-source/install/callback
GitHub__FrontendReturnOrigin=http://localhost:5173
GitHub__StateExpiryMinutes=10
GitHub__AccessRequestExpiryHours=24
GitHub__RepositoryLinks__MaxLinkedRepositories=5
GitHub__RepositoryLinks__MaxEnabledRepositories=5
GitHub__SyncIntervalMinutes=15
GitHub__ClientId=CHANGE_ME
GitHub__ClientSecret=CHANGE_ME
GitHub__PrivateKeyBase64=CHANGE_ME
# Alternative for file-mounted secrets: GitHub__PrivateKeyPath=/run/secrets/github-app.pem
GitHub__WebhookSecret=CHANGE_ME
GitHub__Webhook__MaxPayloadBytes=1048576
GitHub__Webhook__MaxAttempts=5
GitHub__Webhook__ProcessingLeaseSeconds=300
GitHub__Webhook__PollIntervalSeconds=5
Services__Project__BaseUrl=http://localhost:5102/
