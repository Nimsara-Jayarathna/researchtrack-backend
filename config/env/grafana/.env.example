# Grafana admin login credentials. Username can stay as a simple default since
# Grafana is never publicly reachable (SSH-tunnel-only, see deploy/compose.yml).
# Password must be a real, random, unique value — checked by
# deploy/validate-env-files.sh, deployment fails if left as CHANGE_ME.
GF_SECURITY_ADMIN_USER=CHANGE_ME
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Disables public self-registration. Should remain "false" in every environment.
GF_USERS_ALLOW_SIGN_UP=false

# The URL used to reach Grafana through the SSH tunnel to the VPS.
# Must match this environment's GRAFANA_HOST_PORT (a GitHub Environment
# variable under Settings > Environments > test/production — not yet
# wired into the deploy workflow's generated deploy.env as of this ticket).
GF_SERVER_ROOT_URL=CHANGE_ME