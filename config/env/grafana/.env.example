# Grafana admin login credentials. Password must be a real, random, unique
# value — checked by deploy/validate-env-files.sh (Test) and
# deploy/azure/validation/validate-azure-env-files.sh (Production).
# Test: Grafana is loopback-only on the VPS (SSH tunnel, deploy/compose.yml).
# Production: Grafana is public only through Nginx HTTPS on the Azure VM.
GF_SECURITY_ADMIN_USER=CHANGE_ME
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Disables public self-registration. Should remain "false" in every environment.
GF_USERS_ALLOW_SIGN_UP=false

# The URL users reach Grafana at.
# Test: the SSH-tunnel URL, matching the `test` Environment's GRAFANA_HOST_PORT
#       (e.g. http://localhost:9000).
# Production: https://<PRODUCTION_GRAFANA_HOSTNAME>
#       (default https://grafana.researchtrack.blipzo.xyz; enforced by the validator).
GF_SERVER_ROOT_URL=CHANGE_ME
