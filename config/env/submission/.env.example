# ResearchTrack Submission Service configuration contract.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5106
OpenApi__Enabled=true
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3307;Database=CHANGE_ME;User=CHANGE_ME;Password=CHANGE_ME;SslMode=Disabled;AllowPublicKeyRetrieval=true
Database__Host=127.0.0.1
Database__Port=3307
Database__Name=CHANGE_ME
Database__TestName=CHANGE_ME
Database__Username=CHANGE_ME
Database__Password=CHANGE_ME
Database__SslMode=CHANGE_ME
Database__AllowPublicKeyRetrieval=CHANGE_ME

Services__Project__BaseUrl=http://localhost:5102/
Services__Auth__BaseUrl=http://localhost:5101/

Submission__DependencyTimeoutSeconds=10
Submission__MaxFileNameLength=255
Submission__AllowedFileTypes__0=pdf
Submission__AllowedFileTypes__1=docx
Submission__AllowedFileTypes__2=pptx
Submission__AllowedFileTypes__3=zip
Submission__UploadSessionLifetimeMinutes=10
Submission__CleanupIntervalMinutes=15

# Leave empty when using normal AWS regional S3.
# Set this only for an S3-compatible custom endpoint.
Storage__Endpoint=
Storage__Bucket=CHANGE_ME
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
Storage__Region=ap-south-1
Storage__MaximumFileSizeBytes=10485760
Storage__PresignedUrlExpirySeconds=300
Storage__ForcePathStyle=false