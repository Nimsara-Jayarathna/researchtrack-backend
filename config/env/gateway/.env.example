# ResearchTrack API Gateway configuration contract.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
OpenApi__Enabled=true
FRONTEND_ORIGIN=CHANGE_ME
AUTH_SERVICE_URL=http://localhost:5101
PROJECT_SERVICE_URL=http://localhost:5102
GITHUB_SERVICE_URL=http://localhost:5103
JIRA_SERVICE_URL=http://localhost:5104
MEETING_SERVICE_URL=http://localhost:5105
SUBMISSION_SERVICE_URL=http://localhost:5106
# Optional k6 gateway exemption. Keep these DEFAULT/DISABLED in permanent
# deployment configuration. The Azure k6 workflow can create a TEMPORARY
# Gateway revision with the VPS egress IPv4 discovered at runtime and a token
# stored as a Container App secret. Never hardcode the VPS IP here.
# Login/reset/webhook limits remain active during testing.
RateLimiting__PerformanceTest__Enabled=false
RateLimiting__PerformanceTest__AllowedIp=0.0.0.0
RateLimiting__PerformanceTest__Token=DISABLED

