# ResearchTrack local JMeter configuration template.
# Copy to tests/performance/config/.env.local and replace placeholders.
# Never commit .env.local or real credentials/tokens.

PERF_BASE_URL=http://localhost:5000
PERF_PROJECT_ID=CHANGE_ME

# Recommended: authenticate once through the real cookie-based login endpoint.
PERF_AUTH_EMAIL=CHANGE_ME
PERF_AUTH_PASSWORD=CHANGE_ME

# Optional alternative: leave the two credential values empty and provide a
# pre-issued raw access JWT (without "Bearer"). Its exp claim must cover the run.
PERF_JWT_TOKEN=

PERF_CONNECT_TIMEOUT_MS=10000
PERF_RESPONSE_TIMEOUT_MS=30000

# Realistic navigation pacing for PERF-001 through PERF-004.
PERF_THINK_TIME_MIN_MS=2000
PERF_THINK_TIME_MAX_MS=5000

# More aggressive pacing used only by PERF-005.
PERF_STRESS_THINK_TIME_MIN_MS=250
PERF_STRESS_THINK_TIME_MAX_MS=1000

# Refuse to start unless the access JWT remains valid for the scenario plus
# this safety margin. This avoids expiry-driven 401s during a measurement.
PERF_TOKEN_EXPIRY_MARGIN_SECONDS=60
