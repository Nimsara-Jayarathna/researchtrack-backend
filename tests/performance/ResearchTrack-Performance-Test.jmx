        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert successful API envelope">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

int status
try {
    status = (prev.responseCode ?: '0') as int
} catch (Exception ignored) {
    return
}
if (status < 200 || status > 299) return

try {
    def body = new JsonSlurper().parseText(prev.responseDataAsString)
    if (!(body instanceof Map) || body.success != true || !body.containsKey('data')) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Expected a successful ResearchTrack API envelope with success=true and data.')
    }
} catch (Exception exception) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Expected JSON API response: ${exception.message}")
}
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Assertion>
