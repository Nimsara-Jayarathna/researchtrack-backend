        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="AUTH Supplied JWT Validation">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"/>
            <stringProp name="parameters"/>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.nio.charset.StandardCharsets

def token = props.get('supplied_jwt')
try {
    if (!token) throw new IllegalArgumentException('PERF_JWT_TOKEN is empty')
    def parts = token.tokenize('.')
    if (parts.size() != 3) throw new IllegalArgumentException('token is not a JWT')
    def payload = new JsonSlurper().parseText(
        new String(Base64.urlDecoder.decode(parts[1]), StandardCharsets.UTF_8)
    )
    long remaining = (payload.exp as long) - (System.currentTimeMillis() / 1000L)
    long required = (props.get('required_token_seconds') ?: '0') as long
    if (remaining < required) {
        throw new IllegalStateException(
            "Access token lifetime (${remaining}s) does not cover the scenario plus safety margin (${required}s)."
        )
    }
    props.put('perf_access_token', token)
    SampleResult.setResponseCode('200')
    SampleResult.setResponseMessage('Access JWT expiry validated')
    SampleResult.setSuccessful(true)
} catch (Exception exception) {
    log.error('Supplied access JWT validation failed.', exception)
    SampleResult.setResponseCode('401')
    SampleResult.setResponseMessage('Access JWT validation failed')
    SampleResult.setResponseData(exception.message ?: 'Access JWT validation failed', 'UTF-8')
    SampleResult.setSuccessful(false)
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
