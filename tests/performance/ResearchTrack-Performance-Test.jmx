            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build login JSON without exposing credentials">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"/>
              <stringProp name="parameters"/>
              <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import java.nio.charset.StandardCharsets

def decode = { String name ->
    def encoded = props.get(name)
    if (!encoded) {
        throw new IllegalStateException("Missing authentication property: ${name}")
    }
    new String(Base64.decoder.decode(encoded), StandardCharsets.UTF_8)
}

vars.put('perf_login_body', JsonOutput.toJson([
    email: decode('auth_email_b64'),
    password: decode('auth_password_b64')
]))
]]></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Extract and validate HttpOnly access cookie">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"/>
              <stringProp name="parameters"/>
              <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.nio.charset.StandardCharsets
import java.util.regex.Pattern

if (prev.responseCode != '200') {
    def detail = ''
    try {
        def body = new JsonSlurper().parseText(prev.responseDataAsString)
        if (body?.error?.code || body?.error?.message) {
            detail = " ${body.error.code ?: ''} - ${body.error.message ?: ''}".trim()
            detail = detail ? " ${detail}" : ''
        }
    } catch (Exception ignored) {
        // The HTTP status remains enough to diagnose a non-JSON proxy response.
    }
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(
        "Authentication setup failed: HTTP ${prev.responseCode} ${prev.responseMessage ?: ''}${detail}".trim()
    )
    return
}

def cookiePattern = Pattern.compile('(?im)^Set-Cookie:\\s*ss_access_token=([^;\\r\\n]+)')
def matcher = cookiePattern.matcher(prev.responseHeaders ?: '')
if (!matcher.find()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Login succeeded but ss_access_token was not returned as an HttpOnly cookie.')
    return
}

def token = matcher.group(1)
try {
    def parts = token.tokenize('.')
    if (parts.size() != 3) throw new IllegalArgumentException('token is not a JWT')
    def payload = new JsonSlurper().parseText(
        new String(Base64.urlDecoder.decode(parts[1]), StandardCharsets.UTF_8)
    )
    long remaining = (payload.exp as long) - (System.currentTimeMillis() / 1000L)
    long required = (props.get('required_token_seconds') ?: '0') as long
    if (remaining < required) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(
            "Fresh access token lifetime (${remaining}s) does not cover the scenario plus safety margin (${required}s)."
        )
        return
    }
    props.put('perf_access_token', token)
} catch (Exception exception) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Unable to validate access-token expiry: ${exception.message}")
}
]]></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Use supplied access JWT">
