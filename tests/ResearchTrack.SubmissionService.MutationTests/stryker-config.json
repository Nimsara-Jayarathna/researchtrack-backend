{
  "stryker-config": {
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "off",
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "report-file-name": "submission-rules-mutation-report",
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/SubmissionFileRules.cs",
      "**/SubmissionResponsibilityRules.cs",
      "**/SubmissionConstants.cs"
    ]
  }
}
