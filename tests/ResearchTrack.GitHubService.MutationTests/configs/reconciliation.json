{
  "stryker-config": {
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "off",
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "report-file-name": "github-reconciliation-policy-mutation-report",
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 100,
      "low": 95,
      "break": 95
    },
    "mutate": [
      "**/GitHubReconciliationPolicy.cs"
    ]
  }
}
