{
  "stryker-config": {
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "off",
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "report-file-name": "auth-user-directory-mutation-report",
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 83,
      "low": 78,
      "break": 78
    },
    "mutate": [
      "**/UserDirectoryService.cs"
    ]
  }
}
