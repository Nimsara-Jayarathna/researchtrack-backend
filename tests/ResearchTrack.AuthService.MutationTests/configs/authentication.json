{
  "stryker-config": {
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "off",
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "report-file-name": "auth-authentication-mutation-report",
    "break-on-initial-test-failure": true,
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 85
    },
    "mutate": [
      "**/UserAuthenticationService.cs"
    ]
  }
}
