# ============================================================
# ResearchTrack local development configuration
# ============================================================
# Copy this file to .env.local and replace every CHANGE_ME value.
# .env.local is a local secret file and must never be committed.

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# ------------------------------------------------------------
# MySQL endpoint used by ResearchTrack development scripts/apps
# ------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# ------------------------------------------------------------
# Frontend and service URLs
# ------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

AUTH_SERVICE_URL=http://localhost:5101/
PROJECT_SERVICE_URL=http://localhost:5102/
GITHUB_SERVICE_URL=http://localhost:5103/
JIRA_SERVICE_URL=http://localhost:5104/
MEETING_SERVICE_URL=http://localhost:5105/
SUBMISSION_SERVICE_URL=http://localhost:5106/

# ------------------------------------------------------------
# Auth Service
# ------------------------------------------------------------
AUTH_DB_NAME=researchtrack_auth
AUTH_TEST_DB_NAME=researchtrack_test_auth
AUTH_DB_USER=rt_auth
AUTH_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Project Service
# ------------------------------------------------------------
PROJECT_DB_NAME=researchtrack_project
PROJECT_TEST_DB_NAME=researchtrack_test_project
PROJECT_DB_USER=rt_project
PROJECT_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# GitHub Service
# ------------------------------------------------------------
GITHUB_DB_NAME=researchtrack_github
GITHUB_TEST_DB_NAME=researchtrack_test_github
GITHUB_DB_USER=rt_github
GITHUB_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Jira Service
# ------------------------------------------------------------
JIRA_DB_NAME=researchtrack_jira
JIRA_TEST_DB_NAME=researchtrack_test_jira
JIRA_DB_USER=rt_jira
JIRA_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Meeting Service
# ------------------------------------------------------------
MEETING_DB_NAME=researchtrack_meeting
MEETING_TEST_DB_NAME=researchtrack_test_meeting
MEETING_DB_USER=rt_meeting
MEETING_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Submission Service
# ------------------------------------------------------------
SUBMISSION_DB_NAME=researchtrack_submission
SUBMISSION_TEST_DB_NAME=researchtrack_test_submission
SUBMISSION_DB_USER=rt_submission
SUBMISSION_DB_PASSWORD=CHANGE_ME
